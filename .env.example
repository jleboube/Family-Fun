# Gemini API Key for AI-powered features
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth Client ID for Sign-In
# Create at: https://console.cloud.google.com/apis/credentials
# 1. Create a new OAuth 2.0 Client ID (Web application)
# 2. Add authorized JavaScript origins:
#    - http://localhost:7943 (for Docker)
#    - http://localhost:3000 (for local dev)
# 3. Copy the Client ID here
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Admin Email Address
# Users who sign in with this email will automatically be granted admin privileges
ADMIN_EMAIL=your_admin_email@gmail.com
